{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/build",
  "installCommand": "npm install; cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
